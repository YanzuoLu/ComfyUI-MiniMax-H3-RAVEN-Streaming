# Files excluded from the Comfy Registry package.
# gitignore syntax. Keep the runtime package (raven_streaming/) and web/ assets.
#
# Deliberately NOT excluded, and both must stay in the archive:
#   example_workflows/  -- the UI workflow template + its thumbnail. ComfyUI
#                          globs <custom_node>/example_workflows/*.json and
#                          publishes each one under Workflow -> Browse
#                          Templates -> Extensions.
#   api_workflows/      -- the API prompt. Outside the template scan on purpose
#                          (`workflow`/`workflows`/`example`/`examples` are the
#                          other scanned aliases), since an API prompt offered
#                          as a template opens as a broken graph.
# The `examples/` line below is a directory named exactly `examples` and does
# NOT match `example_workflows/`.

# Development-only trees
tests/
docs/
tools/
scripts/
examples/
.github/

# Caches, upstream checkouts and build artifacts
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local model / IO trees that must never be published
models/
output/
temp/
input/

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Docs that are not the registry README
COMPATIBILITY.md
